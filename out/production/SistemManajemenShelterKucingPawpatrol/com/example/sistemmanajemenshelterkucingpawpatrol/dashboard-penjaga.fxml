<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.sistemmanajemenshelterkucingpawpatrol.DashboardPenjagaController">

    <children>

        <!-- TEXT SELAMAT DATANG -->
        <Label fx:id="labelWelcome" layoutX="150.0" layoutY="50.0"
               text="Login berhasil! Selamat datang, Penjaga">
            <font>
                <Font size="16.0"/>
            </font>
        </Label>

        <!-- JUDUL MENU -->
        <Label layoutX="180.0" layoutY="100.0"
               text="&lt;&lt; Menu Utama Shelter &gt;&gt;">
            <font>
                <Font size="14.0"/>
            </font>
        </Label>

        <!-- BUTTON MENU -->
        <Button layoutX="200.0" layoutY="150.0"
                text="1. Kelola Data Kucing"
                onAction="#handleKelolaKucing"/>

        <Button layoutX="200.0" layoutY="190.0"
                text="2. Kelola Adopsi"
                onAction="#handleKelolaAdopsi"/>

        <Button layoutX="200.0" layoutY="230.0"
                text="3. Logout &amp; Keluar"
                onAction="#handleLogout"/>

    </children>
</AnchorPane>