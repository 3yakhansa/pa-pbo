<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.example.papbojavafx.LoginController"
           styleClass="root">

    <VBox alignment="CENTER"
          spacing="20"
          maxWidth="420"
          styleClass="auth-box">

        <!-- Logo -->
        <VBox alignment="CENTER" spacing="5">

            <Label text="🐱"
                   styleClass="big-cat"/>

            <Label text="PawPatrol Shelter"
                   styleClass="title"/>

            <Label text="Temukan kucing pilihanmu hari ini 🐾"
                   styleClass="subtitle"/>

        </VBox>

        <!-- Tabs -->
        <HBox alignment="CENTER"
              spacing="10">

            <Button text="Login"
                    fx:id="btnLoginTab"
                    onAction="#showLoginForm"
                    styleClass="tab-active"/>

            <Button text="Register"
                    fx:id="btnRegisterTab"
                    onAction="#showRegisterForm"
                    styleClass="tab-button"/>

        </HBox>

        <!-- MESSAGE -->
        <Label fx:id="lblMessage"
               styleClass="message"/>

        <!-- LOGIN FORM -->
        <VBox fx:id="loginPane"
              spacing="15"
              alignment="CENTER">

            <TextField fx:id="txtLoginUser"
                       promptText="Masukkan username..."
                       styleClass="input"/>

            <PasswordField fx:id="txtLoginPass"
                           promptText="Masukkan password..."
                           styleClass="input"/>

            <Button text="🔑 Masuk"
                    onAction="#handleLogin"
                    styleClass="main-button"/>
        </VBox>

        <!-- REGISTER FORM -->
        <VBox fx:id="registerPane"
              spacing="15"
              alignment="CENTER"
              visible="false"
              managed="false">

            <TextField fx:id="txtRegisterUser"
                       promptText="Buat username..."
                       styleClass="input"/>

            <PasswordField fx:id="txtRegisterPass"
                           promptText="Buat password..."
                           styleClass="input"/>

            <PasswordField fx:id="txtRegisterConfirm"
                           promptText="Ulangi password..."
                           styleClass="input"/>

            <Button text="📝 Daftar"
                    onAction="#handleRegister"
                    styleClass="main-button"/>
        </VBox>

        <padding>
            <Insets top="30" right="30" bottom="30" left="30"/>
        </padding>

    </VBox>
</StackPane>